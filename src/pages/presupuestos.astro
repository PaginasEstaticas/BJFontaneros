---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadScripts from "../components/LoadScripts.astro";
import Hero2 from "../components/Hero2.astro";
import ZohoForm from "../components/ZohoForm.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <Hero2
                title="¡PRESUPUESTO SIN COMPROMISO!"
                description="Fontanería, reformas y averías. Cuéntanos qué necesitas y te responderemos de inmediato."
            />
            <ZohoForm />
        </main>
        <Footer />
        <LoadScripts />
    </body>
</html>
