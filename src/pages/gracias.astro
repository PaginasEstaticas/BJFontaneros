---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LoadScripts from "../components/LoadScripts.astro";
import Hero2 from "../components/Hero2.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Icon from "../components/Icon.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <Hero2
                title="¡Gracias por tu mensaje!"
                description="Hemos recibido tu solicitud y te responderemos lo antes posible."
            />
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="py-3 my-5 text-center">
                            <h3>¿Necesitas una respuesta inmediata?</h3>
                            <h5 class="text-muted">
                                Chatea con nosotros ahora mismo por WhatsApp
                            </h5>
                            <div
                                class="d-flex mt-5 justify-content-center align-items-center"
                            >
                                <a
                                    href="https://wa.me/34689766329"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-whatsapp"
                                >
                                    <span class="icon-social">
                                        <Icon name="whatsapp" />
                                    </span>
                                    <span class="phone-number">689 766 329</span
                                    >
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <Footer />
        <LoadScripts />
    </body>
</html>

<style lang="scss">
    .btn-whatsapp {
        background-color: #25d366;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px 18px;
        font-size: 1.1rem;
        animation: pulse 2s infinite;

        @keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.03);
            }
            100% {
                transform: scale(1);
            }
        }

        &:hover {
            animation-duration: 0.2s;
            animation-timing-function: ease-in-out;
            background-color: #34df73;
        }

        .icon-social {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 2px; /* Ajuste fino para centrado vertical */
        }

        .phone-number {
            font-size: 1rem;
        }
    }
</style>
