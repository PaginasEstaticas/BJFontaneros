---
import Icon from "../components/Icon.astro";
import { buildUrl } from "../helpers/url";

const { origin } = Astro.url;
const returnPath = `${origin}/gracias`;
---

<div class="wrapper bg-gray pb-5 pt-4">
    <div class="container px-4 py-2">
        <form
            id="webform957647000000719152"
            action="https://crm.zoho.eu/crm/WebToLeadForm"
            method="POST"
            accept-charset="UTF-8"
            class="zoho-form"
        >
            <input
                type="hidden"
                name="xnQsjsdp"
                value="de7c1d8332d6a1806647bf4c30f4a55af6b4e15094a38be5b693ae6d693bbb31"
            />
            <input
                type="hidden"
                name="xmIwtLD"
                value="b9ba130e93624e33e2df5b1b1ef42736051d5e5f43622cde11b0e02bcffcd3388fdf116efe589692eb9ec4d031b0b00c"
            />

            <input type="hidden" name="actionType" value="TGVhZHM=" />
            <input type="hidden" name="returnURL" value={returnPath} />
            <!-- <input type="hidden" name="aG9uZXlwb3Q" value="" /> -->

            <!-- <select style="display:none;" name="Lead Status">
                <option selected value="No contactado">No contactado</option>
            </select> -->

            <!-- **********************************  -->

            <div class="form-header text-center mb-5">
                <h2 class="fw-bold text-dark">¿Cómo podemos ayudarte?</h2>
                <p class="text-muted">
                    Déjanos tus datos y te contactaremos en menos de 24h.
                </p>
                <div class="d-flex justify-content-center">
                    <a
                        href="https://wa.me/34689766329"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-whatsapp"
                    >
                        <Icon name="whatsapp" class="icon-social" />
                    </a>
                </div>
            </div>

            <input type="hidden" name="Lead Status" value="" />

            <div class="mb-3">
                <label class="form-label"
                    >Nombre <span class="text-danger">*</span></label
                >
                <input
                    type="text"
                    name="First Name"
                    class="form-control"
                    required
                />
            </div>

            <!-- <div class="mb-3"> -->
            <!-- <label class="form-label"
                    >Apellidos <span class="text-danger">*</span></label
                > -->
            <input
                type="hidden"
                name="Last Name"
                class="form-control"
                value=""
            />
            <!-- </div> -->

            <div class="mb-3">
                <label class="form-label"
                    >Teléfono <span class="text-danger">*</span></label
                >
                <input type="text" name="Phone" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección - Ciudad</label>
                <input
                    type="text"
                    name="Address - City"
                    class="form-control"
                    maxlength="255"
                />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input
                    type="email"
                    name="Email"
                    class="form-control"
                    maxlength="100"
                />
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de servicio</label>
                <select name="Industry" class="form-select form-select-lg">
                    <option value="-None-" selected>-None-</option>
                    <option value="Reforma">Reforma</option>
                    <option value="Reparación">Reparación</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Información">Información</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">¿Cómo nos conociste?</label>
                <select name="Lead Source" class="form-select form-select-lg">
                    <option value="-None-" selected>-None-</option>
                    <option value="Whatsapp">Whatsapp</option>
                    <option value="Instagram">Instagram</option>
                    <option value="TikTok">TikTok</option>
                    <option value="Referido">Referido</option>
                    <option value="Google">Google</option>
                    <option value="Web">Web</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label">Cuéntanos qué necesitas</label>
                <textarea name="Description" class="form-control" rows="3"
                ></textarea>
            </div>

            <div class="mb-3 d-flex justify-content-start gap-3">
                <button
                    type="submit"
                    class="btn btn-primary px-4 py-2 fw-bold shadow-blue"
                    >Enviar Solicitud</button
                >
            </div>

            <div class="mt-4">
                <p class="text-left text-muted fs-6 fst-italic">
                    <small> *Trabajamos en Madrid y alrededores.</small>
                </p>
            </div>
        </form>
    </div>
</div>

<style>
    .zoho-form {
        max-width: 800px;
        margin: 0 auto;
        background-color: #fafafaaf;
        border-radius: 10px;
        padding: 48px 72px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .limpiar-btn {
        border-color: #d4d4d4;
    }

    .btn-whatsapp {
        background-color: #25d366;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 10%;
        transition: transform 0.2s;

        &:hover {
            transform: scale(1.1);
        }
    }
</style>

<script>
    // form html
    const form = document.getElementById(
        "webform957647000000719152",
    ) as HTMLFormElement;

    form?.addEventListener("submit", (e) => {
        const firstName = (
            form.elements.namedItem("First Name") as HTMLInputElement
        ).value;
        const lastName = (form.elements.namedItem("Phone") as HTMLInputElement)
            .value;
        const email = (form.elements.namedItem("Email") as HTMLInputElement)
            .value;
        const submitBtn = form.querySelector(
            'button[type="submit"]',
        ) as HTMLButtonElement;

        // Extra 'required'
        if (!firstName.trim() || !lastName.trim()) {
            alert("Nombre y Teléfono son obligatorios.");
            e.preventDefault();
            return;
        }

        // Validar Email
        if (email.trim().length > 0) {
            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!regex.test(email)) {
                alert("Introduzca un correo válido.");
                e.preventDefault();
                return;
            }
        }

        // Evita doble envío
        if (submitBtn) submitBtn.disabled = true;
    });
</script>
